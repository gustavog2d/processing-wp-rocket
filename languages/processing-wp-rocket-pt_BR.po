#. Plugin Name of the plugin
#: processing-wp-rocket.php includes/admin/class-pwr-admin-page.php:23
#: includes/class-pwr-plugin.php:23 includes/class-pwr-plugin.php:24
msgid "Processing WP Rocket"
msgstr "Processamento WP Rocket"

#. Plugin URI of the plugin
#: processing-wp-rocket.php
msgid "https://github.com/gustavog2d/processing-wp-rocket"
msgstr "https://github.com/gustavog2d/processing-wp-rocket"

#. Description of the plugin
#: processing-wp-rocket.php
msgid ""
"Read-only diagnostics for WP Rocket: per-URL processing status, cache files "
"on disk, optimizations actually applied to each page, SaaS errors, "
"environment checklist and queue health."
msgstr ""
"Diagnóstico somente leitura do WP Rocket: status de processamento por URL, "
"arquivos de cache no disco, otimizações realmente aplicadas em cada página, "
"erros do SaaS, checklist do ambiente e saúde das filas."

#. Author of the plugin
#: processing-wp-rocket.php
msgid "Gustavo Henrique"
msgstr "Gustavo Henrique"

#. Author URI of the plugin
#: processing-wp-rocket.php
msgid "https://github.com/gustavog2d"
msgstr "https://github.com/gustavog2d"

